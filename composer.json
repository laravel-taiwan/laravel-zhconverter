{
    "name": "seta0909/laravel-zhconverter",
    "description": "Laravel 繁簡轉換",
    "license": "MIT",
    "authors": [
        {
            "name": "seta0909",
            "email": "seta0909@gmail.com"
        }
    ],
    "require": {
        "php": "^7.2.5 | ^8.0",
        "illuminate/support": "^5 | ^6 | ^7 | ^8 | ^9 | ^10 | ^11 | ^12 | ^13"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6 | ^4.0.4",
        "phpunit/phpunit": "^8.5.52 | ^9.6.33 | ^10.5 | ^11.5 | ^12.5.8 | ^13.0.3"
    },
    "autoload": {
        "psr-0": {
            "Seta0909\\LaravelZhconverter\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": false
        }
    }
}
